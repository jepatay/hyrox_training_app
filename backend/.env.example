# Server
PORT=3001
NODE_ENV=development

# Access Token - must match the ?access= URL param in the frontend
ACCESS_TOKEN=your_very_secret_token_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Firebase Admin SDK
# Option A: paste the entire service account JSON as a single line
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Option B: individual fields (if you can't use JSON string)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_PRIVATE_KEY_ID=abc123
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com
# FIREBASE_CLIENT_ID=123456789
